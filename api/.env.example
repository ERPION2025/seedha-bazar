DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
# Leave DATABASE_URL empty to use SQLite locally. For Postgres use the parts below.
DB_NAME=seedha
DB_USER=seedha
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# OTP delivery. "console" prints the code in the server log (development only).
OTP_BACKEND=console
