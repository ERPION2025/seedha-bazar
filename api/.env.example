DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
# Leave DATABASE_URL empty to use SQLite locally. For Postgres use the parts below.
DB_NAME=seedha
DB_USER=seedha
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# OTP delivery. "console" prints the code in the server log (development only).
OTP_BACKEND=console
# Pilot only: farmers, buyers and FPO agents sign in with this fixed code until SMS is connected. Leave empty to turn it off.
# Agronomists and admins always get a real random code.
OTP_STATIC_CODE=123456
# Website
SITE_URL=https://seedhabazar.example
CSRF_TRUSTED_ORIGINS=https://seedhabazar.example
OTP_CHANNELS=sms
GA4_ID=
META_PIXEL_ID=
SUPPORT_WHATSAPP=
# Market rates: free key from https://data.gov.in (sign in -> My Account). Without it the rates pages stay empty.
DATA_GOV_IN_API_KEY=
RATES_STATES=
RATES_REFRESH_HOURS=24
DEFAULT_STATE=Madhya Pradesh
# Be polite to the free map service used to turn a location into a district.
GEOCODER_USER_AGENT=SeedhaBazar/1.0 (https://seedhabazar.in; you@example.com)
# SMS and WhatsApp. Until a provider is connected, messages are only recorded (see /console/messages/).
NOTIFY_SMS_BACKEND=notify.backends.LogBackend
NOTIFY_WHATSAPP_BACKEND=notify.backends.LogBackend
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# News and video reader (public feeds; no keys needed)
NEWS_REFRESH_HOURS=6
NEWS_STATES=Madhya Pradesh,Maharashtra
# Uploaded voice notes and photos (kept private; deleted after 180 days)
MEDIA_ROOT=/data/media
# Crop insurance: "manual" until a partner agreement with the national portal exists
INSURANCE_CONNECTOR=manual

# Weather alerts (Open-Meteo). Free for non-commercial use; for commercial use buy their API key and set it here.
WEATHER_API_KEY=
WEATHER_LOOKUP_VILLAGES=1

# --- Added with Institution Connect, the owner console, notifications, feeds and livelihoods ---
# Institution Connect (KVKs, research agencies) is its own site on its own address, served by the same app.
INSTITUTION_HOSTS=connect.seedhabazar.in
INSTITUTION_URL=https://connect.seedhabazar.in
# DJANGO_ALLOWED_HOSTS must list both sites, e.g. seedhabazar.in,www.seedhabazar.in,connect.seedhabazar.in

# HTTPS (production). Raise SECURE_HSTS_SECONDS to 31536000 once https works on every address.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=3600

# Email: sign-in codes for institution staff who choose email. Without EMAIL_HOST, mail is printed to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Seedha Bazar <no-reply@seedhabazar.in>

# Phone notifications (Web Push). Make the keys once with: python manage.py make_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@seedhabazar.in

# WhatsApp Business Cloud API, Facebook login and Messenger (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=seedha_update
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
META_VERIFY_TOKEN=

# Maps: OpenStreetMap's own tiles are for light use only. For real traffic use a keyed provider, e.g.
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY and MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
MAP_PROVIDER=osm
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=
GOOGLE_MAPS_API_KEY=

# Feeds: mKisan advisories (every 6 h), WDRA registered warehouses (a few states a day), IMD (only after IMD whitelists the server IP)
MKISAN_ENABLED=1
ADVISORY_REFRESH_HOURS=6
WDRA_ENABLED=1
WDRA_REFRESH_DAYS=7
WDRA_STATES_PER_RUN=6
IMD_API_ENABLED=0

# Optional server-side speech to text (Bhashini, Government of India)
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# The company shown in the footer and to search engines
COMPANY_NAME=Vindhyachal Farms LLP
COMPANY_ADDRESS=Plot number 39, Palak Vihar, Near Housing Board Colony, Maharajpur, Adhartal, Jabalpur, Madhya Pradesh
COMPANY_EMAIL=pranav@erpion.in
COMPANY_PHONE=9770417301
