DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
# Leave DATABASE_URL empty to use SQLite locally. For Postgres use the parts below.
DB_NAME=seedha
DB_USER=seedha
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# OTP delivery. "console" prints the code in the server log (development only).
OTP_BACKEND=console
# Pilot only: farmers and buyers sign in with this fixed code until SMS is connected. Leave empty to turn it off.
# Agents, agronomists and admins always get a real random code.
OTP_STATIC_CODE=123456
# Website
SITE_URL=https://seedhabazar.example
CSRF_TRUSTED_ORIGINS=https://seedhabazar.example
OTP_CHANNELS=sms
GA4_ID=
META_PIXEL_ID=
SUPPORT_WHATSAPP=
# Market rates: free key from https://data.gov.in (sign in -> My Account). Without it the rates pages stay empty.
DATA_GOV_IN_API_KEY=
RATES_STATES=
RATES_REFRESH_HOURS=24
DEFAULT_STATE=Madhya Pradesh
# Be polite to the free map service used to turn a location into a district.
GEOCODER_USER_AGENT=SeedhaBazar/1.0 (https://seedhabazar.in; you@example.com)
# SMS and WhatsApp. Until a provider is connected, messages are only recorded (see /console/messages/).
NOTIFY_SMS_BACKEND=notify.backends.LogBackend
NOTIFY_WHATSAPP_BACKEND=notify.backends.LogBackend
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
